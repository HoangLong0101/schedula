rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function hasProfile() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return isAuth() && request.auth.token.role != null
        ? request.auth.token.role
        : hasProfile() && profile().role != null
          ? profile().role
          : 'staff';
    }
    function myTenant() {
      return isAuth() && request.auth.token.tenantId != null
        ? request.auth.token.tenantId
        : hasProfile() && profile().tenantId != null
          ? profile().tenantId
          : '';
    }
    function sameTenant(docTenantId) { return myTenant() == docTenantId; }
    function isOwner() { return role() == 'owner'; }
    function hasPermission(name) {
      return isOwner()
        || (
          request.auth.token.permissions is list
          && name in request.auth.token.permissions
        )
        || (
          hasProfile()
          && profile().permissions is list
          && name in profile().permissions
        );
    }
    function canBook() { return hasPermission('booking.manage'); }
    function canReadBooking(data) {
      return isAuth()
        && sameTenant(data.tenantId)
        && (
          role() != 'staff'
          || request.auth.uid == data.staffId
        );
    }
    function ownProfileUpdateFields() {
      return [
        'name',
        'phone',
        'email',
        'avatarUrl',
        'fcmToken',
        'fcmUpdatedAt',
        'updatedAt',
      ];
    }
    function paymentFields() {
      return [
        'paymentStatus',
        'paymentId',
        'paymentAmount',
        'paymentOrderCode',
        'paymentCheckoutUrl',
        'paymentPaidAt',
      ];
    }
    function bookingPaymentUpdateFields() {
      return [
        'status',
        'updatedAt',
        'paymentStatus',
        'paymentId',
        'paymentAmount',
        'paymentOrderCode',
        'paymentCheckoutUrl',
        'paymentPaidAt',
      ];
    }

    match /tenants/{tenantId} {
      allow read: if isAuth() && myTenant() == tenantId;
      allow update: if isOwner() && myTenant() == tenantId;
      allow create: if isAuth()
        && request.resource.data.tenantId == tenantId
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /bookings/{id} {
      allow read: if canReadBooking(resource.data);
      allow write: if false;
    }

    match /customers/{id} {
      allow read: if isAuth()
        && sameTenant(resource.data.tenantId)
        && hasPermission('customer.read');
      allow create: if isAuth()
        && hasPermission('customer.write')
        && sameTenant(request.resource.data.tenantId);
      allow update: if isAuth()
        && hasPermission('customer.write')
        && sameTenant(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isAuth()
        && hasPermission('customer.write')
        && sameTenant(resource.data.tenantId);
    }

    match /users/{userId} {
      allow read: if isAuth()
        && (
          request.auth.uid == userId
          || (isOwner() && sameTenant(resource.data.tenantId))
        );
      allow create: if isAuth()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.role == 'owner'
            && request.resource.data.tenantId is string
            && getAfter(
              /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
            ).data.ownerUid == request.auth.uid
          )
          || (isOwner() && sameTenant(request.resource.data.tenantId))
        );
      allow update: if (
          isOwner()
          && sameTenant(request.resource.data.tenantId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'tenantId',
              'role',
              'permissions',
              'active',
            ])
        ) || (
          isAuth()
          && request.auth.uid == userId
          && sameTenant(resource.data.tenantId)
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ownProfileUpdateFields()
          )
        ) || (
          isAuth()
          && canBook()
          && sameTenant(resource.data.tenantId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt',
          ])
          && request.resource.data.status in [
            'available',
            'in_session',
            'absent',
          ]
        );
      allow delete: if isOwner() && sameTenant(resource.data.tenantId);
    }

    match /services/{id} {
      allow read: if isAuth() && sameTenant(resource.data.tenantId);
      allow create: if isOwner() && sameTenant(request.resource.data.tenantId);
      allow update: if isOwner()
        && sameTenant(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isOwner() && sameTenant(resource.data.tenantId);
    }

    match /products/{id} {
      allow read: if isAuth() && sameTenant(resource.data.tenantId);
      allow create: if isOwner() && sameTenant(request.resource.data.tenantId);
      allow update: if isOwner()
        && sameTenant(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isOwner() && sameTenant(resource.data.tenantId);
    }

    match /equipment/{id} {
      allow read: if isAuth() && sameTenant(resource.data.tenantId);
      allow create: if isOwner() && sameTenant(request.resource.data.tenantId);
      allow update: if isOwner()
        && sameTenant(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isOwner() && sameTenant(resource.data.tenantId);
    }

    match /slots/{id} {
      allow read: if isAuth()
        && sameTenant(resource.data.tenantId)
        && (
          role() != 'staff'
          || request.auth.uid == resource.data.staffId
        );
      allow write: if isAuth() && canBook() && sameTenant(request.resource.data.tenantId);
    }

    match /notifications/{id} {
      allow read: if isAuth()
        && sameTenant(resource.data.tenantId)
        && (
          role() != 'staff'
          || resource.data.recipientUserId == request.auth.uid
        );
      allow update: if isAuth()
        && sameTenant(resource.data.tenantId)
        && (
          role() != 'staff'
          || resource.data.recipientUserId == request.auth.uid
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read',
          'readAt',
        ]);
      allow create, delete: if false;
    }

    match /payments/{id} {
      allow read: if isAuth() && sameTenant(resource.data.tenantId);
      allow write: if false;
    }

    match /tenantStatsDaily/{id} {
      allow read: if isAuth() && sameTenant(resource.data.tenantId);
      allow write: if false;
    }

    match /staffStatsDaily/{id} {
      allow read: if isAuth() && sameTenant(resource.data.tenantId);
      allow write: if false;
    }

    match /serviceStatsDaily/{id} {
      allow read: if isAuth() && sameTenant(resource.data.tenantId);
      allow write: if false;
    }

    match /staffLeaves/{id} {
      allow read: if isAuth() && sameTenant(resource.data.tenantId);
      allow write: if false;
    }

    match /auditEvents/{id} {
      allow read: if isOwner() && sameTenant(resource.data.tenantId);
      allow write: if false;
    }

    match /landingPageEvents/{id} {
      allow read, write: if false;
    }

    match /campaigns/{id} {
      allow read: if isAuth()
        && sameTenant(resource.data.tenantId)
        && hasPermission('report.read');
      allow write: if false;
    }

    match /campaignDeliveries/{id} {
      allow read: if isAuth()
        && sameTenant(resource.data.tenantId)
        && hasPermission('report.read');
      allow write: if false;
    }
  }
}
